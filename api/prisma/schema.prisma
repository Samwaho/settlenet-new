// Prisma schema for hotspot guest registrations
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuestRegistration {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Captive portal captured fields
  fullName      String
  phoneNumber   String

  // Optional context from Mikrotik if we want to store it
  macAddress    String?  @db.VarChar(64)
  ipAddress     String?  @db.VarChar(64)
  loginMethod   String?  @db.VarChar(32) // e.g., "free"
}


